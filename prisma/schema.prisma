
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  // Added a comprehensive list of common Linux binary targets
  // The error specifically mentions debian-openssl-1.1.x, so that's important.
  // NAPI is often more portable. Musl is for Alpine Linux.
  binaryTargets = [
    "native", // Prisma attempts to detect the OS and download the matching engine
    "debian-openssl-1.1.x",
    "debian-openssl-3.0.x",
    "rhel-openssl-1.1.x",
    "rhel-openssl-3.0.x",
    "linux-musl",
    "linux-napi" // Node-API, can sometimes avoid system lib issues
  ]
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews   Review[]
  orders    Order[]
  addresses Address[]
}

model Product {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String
  price        Float
  imageUrl     String
  stock        Int
  rating       Float    @default(0)
  reviewsCount Int      @default(0)
  brand        String?
  features     String[]
  petType      String[] // e.g., ["dog", "cat"]
  dataAiHint   String? // For image search suggestions

  categoryId String   @db.ObjectId
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews    Review[]
  orderItems OrderItem[]
  variants   Json? // Simplified variant storage as JSON for now. Could be a separate model.
                  // Example: [{ "id": "v1", "name": "Size", "value": "Large", "priceModifier": 2.00, "stock": 10, "imageUrl": "..." }]
}

model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  description String?
  imageUrl    String?
  dataAiHint  String?

  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Int
  comment   String
  userName  String // Denormalized for simplicity, or could relate to User.name

  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])

  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// For user-managed addresses (e.g., in account settings)
model Address {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  street    String
  city      String
  state     String
  zipCode   String
  country   String
  fullName  String? // e.g., "Home", "Work", or person's name for the address
  phoneNumber String?
  isDefault Boolean  @default(false)

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
}

// For embedding shipping address directly into an Order.
// This preserves the address at the time of order, even if the user later deletes/updates their saved addresses.
type AddressEmbed {
  street      String
  city        String
  state       String
  zipCode     String
  country     String
  fullName    String?
  phoneNumber String?
}

model Order {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  totalAmount     Float
  status          String        // e.g., "PENDING", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED"
  shippingAddress AddressEmbed? // Embedded address
  paymentMethod   String?
  trackingNumber  String?

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model OrderItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  quantity  Int
  priceAtPurchase Float // Price of the product at the time of order
  nameAtPurchase String // Name of the product at the time of order
  imageUrlAtPurchase String? // Image URL of product at time of order

  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id])

  productId String  @db.ObjectId
  // No direct relation to Product to avoid issues if product is deleted/modified
  // Instead, productId is stored for reference. Details are captured in name/price/imageUrlAtPurchase.

  @@index([orderId])
  @@index([productId])
}
