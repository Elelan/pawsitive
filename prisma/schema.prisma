
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String    @unique
  name      String?
  password  String
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  reviews   Review[]
  orders    Order[]
  addresses Address[]
}

enum Role {
  USER
  ADMIN
}

model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  imageUrl    String?
  description String?
  dataAiHint  String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  description    String
  price          Float
  imageUrl       String
  stock          Int
  brand          String?
  features       String[]      @default([])
  dataAiHint     String?
  petType        String[]      @default([]) // For filtering by pet type
  rating         Float         @default(0)
  reviewsCount   Int           @default(0) // Consider making this a derived field or updated via triggers/transactions
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category       Category      @relation(fields: [categoryId], references: [id])
  categoryId     String        @db.ObjectId

  reviews        Review[]
  orderItems     OrderItem[]
  // variants can be modeled as a separate table or embedded if simple
  // For simplicity, ProductVariant is not a separate model in this schema yet.
}

model Review {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  rating     Int
  comment    String
  userName   String   // Denormalized for easier display; ensure consistency or fetch User.name
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product    Product  @relation(fields: [productId], references: [id])
  productId  String   @db.ObjectId

  user       User     @relation(fields: [userId], references: [id])
  userId     String   @db.ObjectId
}

model Order {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  totalAmount     Float
  status          String        // e.g., "PENDING", "SHIPPED", "DELIVERED", "CANCELLED"
  shippingAddress AddressEmbed // Embedded document for shipping address at time of order
  paymentMethod   String
  trackingNumber  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id])
  userId          String        @db.ObjectId
  items           OrderItem[]
}

model OrderItem {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  quantity           Int
  priceAtPurchase    Float    // Price of one unit of the product at the time of purchase
  nameAtPurchase     String   // Name of the product at the time of purchase
  imageUrlAtPurchase String?  // Image URL of the product at the time of purchase

  order              Order    @relation(fields: [orderId], references: [id])
  orderId            String   @db.ObjectId

  product            Product  @relation(fields: [productId], references: [id])
  productId          String   @db.ObjectId // Refers to the Product ID
}

// Type for embedding address information directly within Order documents
type AddressEmbed {
  street    String
  city      String
  state     String
  zipCode   String
  country   String
  fullName  String?
  phoneNumber String?
}

// Separate model for user-manageable addresses
model Address {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  street      String
  city        String
  state       String
  zipCode     String
  country     String
  fullName    String? // e.g., "Home", "Work"
  phoneNumber String?
  isDefault   Boolean  @default(false)

  user        User     @relation(fields: [userId], references: [id])
  userId      String   @db.ObjectId
}
